TKAUTO_CONTROL_ENVIRONMENT=production
TKAUTO_CONTROL_DATABASE_URL_FILE=/run/secrets/database_url
TKAUTO_CONTROL_ADMIN_TOKEN_FILE=/run/secrets/admin_token
TKAUTO_CONTROL_LICENSE_KEY_PEPPER_FILE=/run/secrets/license_key_pepper
TKAUTO_CONTROL_LEASE_SIGNING_KEY_ID=lease-key-2026-01
TKAUTO_CONTROL_LEASE_SIGNING_PRIVATE_KEY_PATH=C:/secure-keys/lease-key-2026-01.pem
TKAUTO_CONTROL_RELEASE_SIGNING_KEY_ID=release-key-2026-01
TKAUTO_CONTROL_RELEASE_SIGNING_PRIVATE_KEY_PATH=C:/secure-keys/release-key-2026-01.pem
TKAUTO_CONTROL_ARTIFACT_STORAGE_ROOT=D:/private-artifacts
TKAUTO_CONTROL_PUBLIC_BASE_URL=https://license.example.com
TKAUTO_CONTROL_DOWNLOAD_GRANT_SECRET_FILE=/run/secrets/download_grant_secret
TKAUTO_CONTROL_LEASE_TTL_SECONDS=3600
TKAUTO_CONTROL_DOWNLOAD_GRANT_TTL_SECONDS=300
TKAUTO_CONTROL_MAX_CLOCK_SKEW_SECONDS=300
TKAUTO_CONTROL_MINIMUM_CLIENT_VERSION=0.1.0
TKAUTO_CONTROL_MINIMUM_BACKEND_VERSION=0.1.0
TKAUTO_CONTROL_TRUSTED_HOSTS=license.example.com
TKAUTO_CONTROL_ACTIVATION_RATE_LIMIT_PER_MINUTE=10
TKAUTO_CONTROL_DEVICE_RATE_LIMIT_PER_MINUTE=120
TKAUTO_CONTROL_ADMIN_RATE_LIMIT_PER_MINUTE=120
