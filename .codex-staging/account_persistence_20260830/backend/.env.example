# Product default: use the independently vendored patched Firefox runtime.
IBS_RUNTIME=invisible
IBS_HOST=127.0.0.1
IBS_PORT=8010
IBS_SCHEDULER_WORKERS=4
IBS_MAX_QUEUED_JOBS=256
IBS_MAX_SESSIONS=64
IBS_MAX_UPLOAD_BYTES=2147483648
IBS_UPLOAD_ROOT=./.runtime/uploads
IBS_DATABASE_PATH=.runtime/control-plane.sqlite3
IBS_CREDENTIALS_KEY_PATH=.runtime/credentials.key
IBS_CORS_ORIGINS=http://127.0.0.1:5184,http://localhost:5184
IBS_STREAM_JPEG_QUALITY=85
IBS_STREAM_INTERVAL_SECONDS=0.08
IBS_STREAM_MAX_WIDTH=1024
IBS_EXTENSION_PATH=./vendor/extensions/omocaptcha_auto_solve_captcha-1.7.7.sanitized.xpi
IBS_EXTENSIONS_REQUIRED=true
IBS_OMOCAPTCHA_EXTENSION_UUID=d6105ea0-8d34-41ab-85a7-2eb0c66d55bb

# Secrets belong only in a local .env or secret manager.
# IBS_OMOCAPTCHA_API_KEY=
# Optional Fernet key; when omitted, a local key file is generated once.
# IBS_CREDENTIALS_KEY=
