# Mau secret cho Edge Function. KHONG dien gia tri that vao file nay - copy
# thanh `supabase/.env` (da bi gitignore) roi dien o do.
#
# Dat len Supabase bang:
#   tools/supabase-cli/node_modules/.bin/supabase secrets set --env-file supabase/.env
#
# SUPABASE_URL va SUPABASE_SERVICE_ROLE_KEY KHONG can dat: Supabase tu cap hai
# bien do cho moi Edge Function.

# Pepper de bam license key. PHAI giong y cai o
# <operator>/secrets/license-key-pepper, vi CLI admin bam digest bang cai do
# con Edge Function tra cuu bang cai nay. Lech nhau thi moi key deu bao sai.
TKAUTO_LICENSE_KEY_PEPPER=

# kid cua khoa ky lease. Lay ten khoa trong <operator>/desktop-public-keys.json,
# vi ban desktop duoc build voi khoa cong khai mang dung id do.
TKAUTO_LEASE_SIGNING_KEY_ID=

# Khoa rieng ky lease. Dan PHAN BASE64 TREN MOT DONG, khong can dau
# -----BEGIN-----: loader go dau PEM va moi khoang trang truoc khi decode, va
# mot dong thi khong the bi mat dau dong khi dat secret. Lay bang:
#   python -c "import re,sys;print(re.sub(r'-----[A-Z ]+-----|\s+','',open(sys.argv[1]).read()))" <operator>/keys/lease-private.pem
TKAUTO_LEASE_SIGNING_PRIVATE_KEY_PEM=

# San phien ban. Duoi san thi client nhan HTTP 426 va duoc bao di cap nhat.
TKAUTO_MINIMUM_CLIENT_VERSION=0.1.0
TKAUTO_MINIMUM_BACKEND_VERSION=0.1.0

# Tuy chon. Bo trong thi dung mac dinh ghi trong service.ts.
# TKAUTO_LEASE_TTL_SECONDS=3600
# TKAUTO_MAX_CLOCK_SKEW_SECONDS=300
# TKAUTO_ACTIVATION_RATE_LIMIT_PER_MINUTE=10
# TKAUTO_DEVICE_RATE_LIMIT_PER_MINUTE=120
